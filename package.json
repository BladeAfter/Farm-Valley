{
  "name": "farm-valley",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:check": "tsx scripts/database.ts check",
    "db:import": "tsx scripts/database.ts import",
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/api/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "server": "tsx server/api/index.ts",
    "assets": "node scripts/assets/generate.mjs",
    "format": "prettier --write src server tests scripts vite.config.ts",
    "test:browser": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.13.0",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
